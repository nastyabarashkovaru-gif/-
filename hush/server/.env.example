# Токен бота из @BotFather (обязательно). Никогда не коммитьте настоящий токен.
BOT_TOKEN=
# Строка подключения PostgreSQL (на Railway подставляется из сервиса Postgres)
DATABASE_URL=postgres://hush:hush@localhost:5432/hush
# Публичный HTTPS-адрес приложения. На Railway можно не задавать — берётся RAILWAY_PUBLIC_DOMAIN
PUBLIC_URL=
# Username бота без @. Если не задан — берётся из Telegram (getMe)
BOT_USERNAME=Hush_miniapp_bot
# Short name Mini App из @BotFather (/newapp)
APP_SHORT_NAME=app
# Telegram ID или @username через запятую — годовой Premium для тестов (пока нет оплаты)
GRANT_PREMIUM_IDS=
PORT=8080
