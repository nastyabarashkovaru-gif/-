# --- Обязательные ---------------------------------------------------------
# Строка подключения PostgreSQL (на Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rostok
# production | demo | development. В production запрещены mock-оплата и демо-вход.
APP_ENV=development

# --- Telegram -------------------------------------------------------------
# Токен бота от @BotFather. Нужен для входа через Telegram, оплаты Stars и напоминаний.
BOT_TOKEN=
# Username бота без @ (если пусто — определяется через getMe)
BOT_USERNAME=
# Short name Mini App из /newapp (для ссылок t.me/<bot>/<app>?startapp=…)
APP_SHORT_NAME=app
# Публичный HTTPS-адрес (на Railway подставляется автоматически из RAILWAY_PUBLIC_DOMAIN)
PUBLIC_URL=
# Срок годности initData, сек.
INIT_DATA_TTL=86400

# --- Оплата ---------------------------------------------------------------
# telegram_stars (production) | mock (только demo/development)
PAYMENT_PROVIDER=

# --- Админка --------------------------------------------------------------
# Владелец создаётся при первом запуске; пароль ≥ 10 символов
ADMIN_LOGIN=owner
ADMIN_PASSWORD=

# --- Прочее ---------------------------------------------------------------
SUPPORT_USERNAME=
PORT=8080
# false — отключить фоновые задания (например, на второй реплике)
WORKER_ENABLED=true
# Вход в браузере без Telegram (только вне production)
DEMO_LOGIN=true
