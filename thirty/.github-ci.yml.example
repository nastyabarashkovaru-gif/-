# Пример CI (GitHub Actions): положить в .github/workflows/thirty.yml в корне репозитория
name: thirty
on: { push: { paths: ['thirty/**'] }, pull_request: { paths: ['thirty/**'] } }
jobs:
  test:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env: { POSTGRES_USER: thirty, POSTGRES_PASSWORD: thirty, POSTGRES_DB: thirty_test }
        ports: ['5432:5432']
        options: --health-cmd pg_isready --health-interval 5s --health-retries 10
    defaults: { run: { working-directory: thirty } }
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 22, cache: npm, cache-dependency-path: thirty/package-lock.json }
      - run: npm ci
      - run: npm run typecheck
      - run: npx prisma generate
        working-directory: thirty/apps/server
      - run: npm test
      - run: npm run build
