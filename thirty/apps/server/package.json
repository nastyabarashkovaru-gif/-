{
  "name": "@thirty/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && node build.mjs",
    "start": "prisma migrate deploy && node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "esbuild": "^0.28.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "^6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/luxon": "^3.7.6",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "qrcode": "^1.5.4",
    "qs": "^6.16.1",
    "zod": "^3.25.76"
  }
}
