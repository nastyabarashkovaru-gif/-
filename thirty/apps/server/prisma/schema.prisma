// «30 дней» — схема БД. Даты потоков и отчётов — DATE (в часовом поясе потока), моменты времени — timestamptz.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Пользователи и согласия ─────────────

enum Visibility {
  public // видно всем участникам клуба
  members // видно только участникам того же потока
  hidden // скрыт из поиска (отчёты всё равно публичны в ленте)
}

model User {
  id              BigInt     @id // Telegram user id
  firstName       String
  lastName        String?
  username        String?
  photoUrl        String?
  displayName     String?
  city            String?
  timezone        String     @default("Europe/Moscow")
  interests       String[]   @default([])
  visibility      Visibility @default(public)
  isAdult         Boolean    @default(false)
  allowsWrite     Boolean    @default(false)
  botBlocked      Boolean    @default(false)
  marketingOptIn  Boolean    @default(false)
  lastScreen      String?
  onboardingStage String     @default("new") // new | onboarding | tariffs | checkout | paid | registered
  sixMonthBadge   Boolean    @default(false)
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  consents      Consent[]
  subscriptions Subscription[]
  payments      Payment[]
  memberships   FlowMembership[]
  offers        PriceOffer[]
  media         MediaFile[]
  events        AnalyticsEvent[]
  botLogs       BotMessageLog[]
  reviews       Review[]
  referralLink  ReferralLink?
  comments      ReportComment[]
  reactions     ReportReaction[]
  complaints    Complaint[]
  attendances   Attendance[]
  experiments   ExperimentAssignment[]
  feedMessages  FeedMessage[]

  @@index([city])
  @@index([createdAt])
}

enum ConsentKind {
  personal_data // обработка ПДн
  offer // публичная оферта и правила
  public_reports // осознаю, что отчёты публичны
  adult // мне есть 18
  sensitive_photos // хранение чувствительных фото «ДО/ПОСЛЕ»
  marketing_messages // рекламные сообщения бота
  case_text // публикация текста отзыва в рекламе
  case_photo // публикация фото
  case_name // публикация имени
  autorenew // согласие на автопродление
}

model Consent {
  id        String      @id @default(uuid())
  userId    BigInt
  user      User        @relation(fields: [userId], references: [id])
  kind      ConsentKind
  version   String
  granted   Boolean
  context   String? // например reviewId
  createdAt DateTime    @default(now())
  revokedAt DateTime?

  @@index([userId, kind])
}

// ───────────── Тарифы, предложения, подписки, платежи ─────────────

model Tariff {
  id                          String   @id // m1 | m3 | m6
  title                       String
  months                      Int
  goalLimit                   Int? // null = без ограничения
  promoPrice                  Int // ₽, первые 3 часа
  regularPrice                Int // ₽, после таймера
  comparisonMonthPrice        Int      @default(2990) // «стоимость отдельных месяцев» = months × это
  renewalPrice                Int // ₽, сумма повторного списания (должна совпадать с кабинетом Prodamus)
  prodamusSubscriptionPromo   Int?
  prodamusSubscriptionRegular Int?
  highlighted                 Boolean  @default(false)
  badge                       String?
  features                    Json     @default("[]")
  sort                        Int      @default(0)
  active                      Boolean  @default(true)
  updatedAt                   DateTime @updatedAt

  subscriptions Subscription[]
}

model PriceOffer {
  id         String    @id @default(uuid())
  userId     BigInt
  user       User      @relation(fields: [userId], references: [id])
  kind       String    @default("intro") // intro | referral_restore
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime? // покупка по этой цене

  @@unique([userId, kind])
}

enum SubscriptionStatus {
  prestart // оплачено, поток ещё не начался
  active
  past_due
  canceled_at_period_end
  expired
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 BigInt
  user                   User               @relation(fields: [userId], references: [id])
  tariffId               String
  tariff                 Tariff             @relation(fields: [tariffId], references: [id])
  status                 SubscriptionStatus @default(prestart)
  autoRenew              Boolean            @default(true)
  renewalPrice           Int
  priceVariant           String             @default("promo") // promo | regular
  paidFromFlow           DateTime           @db.Date
  paidThroughFlow        DateTime           @db.Date // startsOn последнего оплаченного потока
  nextChargeDate         DateTime?          @db.Date
  providerSubscriptionId String?
  providerLocked         Boolean            @default(false)
  /**
   * Телефон/e-mail покупателя из webhook — нужен для REST-методов Prodamus
   */
  providerCustomer       Json               @default("{}")
  /**
   * Автопродление выключено у провайдера (иначе задача повторяет запрос)
   */
  providerDeactivatedAt  DateTime?
  canceledAt             DateTime?
  cancelReason           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  payments    Payment[]
  schedule    BillingSchedule[]
  memberships FlowMembership[]
  // + частичный уникальный индекс «одна живая подписка на пользователя» (миграция SQL)

  @@index([userId])
  @@index([status, nextChargeDate])
}

enum PaymentStatus {
  initiated
  pending
  paid
  failed
  refunded
  disputed
}

enum PaymentKind {
  initial
  renewal
  debt
  upsell
}

model Payment {
  id              String        @id @default(uuid())
  userId          BigInt
  user            User          @relation(fields: [userId], references: [id])
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  kind            PaymentKind
  tariffId        String?
  upsellCode      String?
  priceVariant    String? // promo | regular
  amount          Int
  status          PaymentStatus @default(initiated)
  provider        String        @default("prodamus")
  providerOrderId String?       @unique
  paymentUrl      String?
  coversFromFlow  DateTime?     @db.Date
  months          Int?
  idempotencyKey  String        @unique
  failureReason   String?
  /**
   * Повторная успешная оплата при уже живой подписке — доступ не выдаётся, нужен возврат
   */
  needsRefund     Boolean       @default(false)
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events PaymentEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id             String    @id @default(uuid())
  provider       String
  paymentId      String?
  payment        Payment?  @relation(fields: [paymentId], references: [id])
  bodyHash       String    @unique // повторный webhook отсекается
  signatureValid Boolean
  status         String?
  payload        Json
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
}

model BillingSchedule {
  id               String       @id @default(uuid())
  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id])
  dueDate          DateTime     @db.Date
  coversFromFlow   DateTime     @db.Date
  months           Int
  amount           Int
  status           String       @default("scheduled") // scheduled | synced | charged | failed | canceled
  providerSyncedAt DateTime?
  syncError        String?
  createdAt        DateTime     @default(now())

  @@unique([subscriptionId, coversFromFlow])
}

// ───────────── Потоки, цели, задачи ─────────────

enum FlowStatus {
  upcoming
  active
  finished
}

model Flow {
  id                String     @id @default(uuid())
  startsOn          DateTime   @unique @db.Date
  endsOn            DateTime   @db.Date
  timezone          String     @default("Europe/Moscow")
  title             String
  status            FlowStatus @default(upcoming)
  prizePoolOverride Int?
  finalizedAt       DateTime?
  createdAt         DateTime   @default(now())

  memberships FlowMembership[]
  chats       TelegramChat[]
  buddyPairs  BuddyPair[]
  leaderboard LeaderboardEntry[]
  candidates  PrizeCandidate[]
  messages    FeedMessage[]
}

enum MembershipStatus {
  reserved // оплачен, анкета не заполнена
  registered // цели зафиксированы
  active
  finished
  revoked // возврат
}

model FlowMembership {
  id               String           @id @default(uuid())
  userId           BigInt
  user             User             @relation(fields: [userId], references: [id])
  flowId           String
  flow             Flow             @relation(fields: [flowId], references: [id])
  subscriptionId   String?
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id])
  tariffId         String
  status           MembershipStatus @default(reserved)
  goalsLockedAt    DateTime?
  registeredAt     DateTime?
  finalSubmittedAt DateTime?
  createdAt        DateTime         @default(now())

  goals       Goal[]
  occurrences TaskOccurrence[]
  reports     DailyReport[]
  beforeAfter BeforeAfter[]
  shareCards  ShareCard[]

  @@unique([userId, flowId])
  @@index([flowId, status])
}

enum GoalCategory {
  money
  weightloss
  blog
  english
  habits
  selfdev
  other
}

model Goal {
  id               String         @id @default(uuid())
  membershipId     String
  membership       FlowMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  category         GoalCategory
  title            String
  successCriterion String
  /// Точка А — где участник сейчас; точка Б — результат через 30 дней
  pointA           String?
  pointB           String?
  /// Как подтвердим результат: screenshot | photo_video | document | daily_reports | other
  confirmMethod    String?
  confirmNote      String?
  isPublic         Boolean        @default(true)
  sort             Int            @default(0)
  finalAchieved    Boolean?
  finalComment     String?
  createdAt        DateTime       @default(now())

  tasks Task[]
}

enum Frequency {
  daily
  every_n_days
  n_per_week
  once
}

enum EvidenceType {
  checkbox
  photo
  screenshot
  checkbox_photo // галочка + фото по политике задачи
  link
}

model Task {
  id           String       @id @default(uuid())
  goalId       String
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title        String
  frequency    Frequency
  n            Int          @default(1)
  /// Одноразовая задача: выполнить до этой даты включительно
  dueDate      DateTime?    @db.Date
  evidence     EvidenceType @default(checkbox)
  criteria     String?
  selfReported Boolean      @default(false)
  createdAt    DateTime     @default(now())

  occurrences TaskOccurrence[]
}

enum OccurrenceStatus {
  pending
  done
  missed
}

model TaskOccurrence {
  id           String           @id @default(uuid())
  taskId       String
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membershipId String
  membership   FlowMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  windowStart  DateTime         @db.Date
  windowEnd    DateTime         @db.Date
  slot         Int              @default(0)
  status       OccurrenceStatus @default(pending)
  doneAt       DateTime?
  reportItems  ReportItem[]

  @@unique([taskId, windowStart, slot])
  @@index([membershipId, windowEnd])
}

// ───────────── Отчёты ─────────────

enum ReportStatus {
  accepted
  rejected // модерация
}

model DailyReport {
  id           String         @id @default(uuid())
  membershipId String
  membership   FlowMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  date         DateTime       @db.Date
  text         String?
  status       ReportStatus   @default(accepted)
  rejectReason String?
  late         Boolean        @default(false) // принят через апелляцию
  /// Фото отчёта: минимум одно на весь отчёт (решение владельца 24.10)
  mediaIds     String[]       @default([])
  createdAt    DateTime       @default(now())

  items      ReportItem[]
  comments   ReportComment[]
  reactions  ReportReaction[]
  complaints Complaint[]
  appeals    ReportAppeal[]

  @@unique([membershipId, date])
  @@index([createdAt])
}

model ReportItem {
  id           String         @id @default(uuid())
  reportId     String
  report       DailyReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  occurrenceId String
  occurrence   TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  done         Boolean
  note         String?
  link         String?
  flagged      Boolean        @default(false) // подозрительное доказательство (вручную)

  evidence ReportEvidence[]

  @@unique([reportId, occurrenceId])
}

model ReportEvidence {
  id      String     @id @default(uuid())
  itemId  String
  item    ReportItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mediaId String
  media   MediaFile  @relation(fields: [mediaId], references: [id])
}

model ReportComment {
  id        String      @id @default(uuid())
  reportId  String
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    BigInt
  user      User        @relation(fields: [userId], references: [id])
  text      String
  hidden    Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([reportId, createdAt])
}

model ReportReaction {
  reportId  String
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    BigInt
  user      User        @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime    @default(now())

  @@id([reportId, userId, emoji])
}

model Complaint {
  id           String       @id @default(uuid())
  reporterId   BigInt
  reporter     User         @relation(fields: [reporterId], references: [id])
  reportId     String?
  report       DailyReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  targetUserId BigInt?
  kind         String // report | comment | buddy | user
  reason       String
  status       String       @default("open") // open | resolved | dismissed
  resolution   String?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
}

model ReportAppeal {
  id        String      @id @default(uuid())
  reportId  String
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reason    String
  status    String      @default("open") // open | approved | rejected
  decidedBy String?
  decision  String?
  createdAt DateTime    @default(now())
}

model MediaFile {
  id         String   @id @default(uuid())
  ownerId    BigInt
  owner      User     @relation(fields: [ownerId], references: [id])
  storageKey String   @unique
  mime       String
  size       Int
  sensitive  Boolean  @default(false)
  createdAt  DateTime @default(now())

  evidence ReportEvidence[]
}

model BeforeAfter {
  id           String         @id @default(uuid())
  membershipId String
  membership   FlowMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  phase        String // before | after
  text         String?
  metrics      Json           @default("{}")
  mediaIds     String[]       @default([])
  createdAt    DateTime       @default(now())

  @@unique([membershipId, phase])
}

// ───────────── Рейтинг и призы ─────────────

model LeaderboardEntry {
  flowId         String
  flow           Flow     @relation(fields: [flowId], references: [id])
  userId         BigInt
  ratio          Float
  completed      Int
  scheduled      Int
  successfulDays Int
  missedReports  Int
  longestStreak  Int
  currentStreak  Int
  perfectSoFar   Boolean
  /// Дни с отчётом, сданным в свой день — второй критерий сортировки
  reportDays     Int      @default(0)
  rank           Int
  computedAt     DateTime @default(now())

  @@id([flowId, userId])
  @@index([flowId, rank])
}

enum PrizeStatus {
  awaiting_review
  approved
  rejected
  appealed
}

model PrizeCandidate {
  id        String      @id @default(uuid())
  flowId    String
  flow      Flow        @relation(fields: [flowId], references: [id])
  userId    BigInt
  status    PrizeStatus @default(awaiting_review)
  place     Int?
  tiebreak  Json        @default("{}")
  createdAt DateTime    @default(now())

  reviews PrizeReview[]

  @@unique([flowId, userId])
}

model PrizeReview {
  id          String         @id @default(uuid())
  candidateId String
  candidate   PrizeCandidate @relation(fields: [candidateId], references: [id])
  adminId     String
  decision    String // approve | reject | appeal_open | appeal_approve | appeal_reject | place
  reason      String
  createdAt   DateTime       @default(now())
}

// ───────────── Бадди ─────────────

model BuddyInvite {
  id         String   @id @default(uuid())
  flowId     String
  fromUserId BigInt
  toUserId   BigInt?
  token      String   @unique
  status     String   @default("pending") // pending | accepted | declined | expired
  createdAt  DateTime @default(now())

  @@index([flowId, toUserId])
}

model BuddyPair {
  id          String    @id @default(uuid())
  flowId      String
  flow        Flow      @relation(fields: [flowId], references: [id])
  userA       BigInt
  userB       BigInt
  source      String // invite | auto | replacement | admin
  matchReason String?
  status      String    @default("active") // active | dissolved
  dissolvedAt DateTime?
  createdAt   DateTime  @default(now())

  assignments BuddyAssignment[]

  @@index([flowId, status])
}

// Строка на каждого участника пары: уникальность (flowId, userId) среди активных — не больше одного бадди
model BuddyAssignment {
  flowId String
  userId BigInt
  pairId String
  pair   BuddyPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@id([flowId, userId])
}

model BuddyReplacement {
  id          String   @id @default(uuid())
  pairId      String
  requesterId BigInt
  reason      String // mutual | no_contact_5d | complaint
  comment     String?
  status      String   @default("open") // open | approved | rejected | waiting_pool
  decidedBy   String?
  createdAt   DateTime @default(now())
}

// ───────────── Чаты, эксперты, созвоны ─────────────

model TelegramChat {
  id             String   @id @default(uuid())
  kind           String // flow | topic
  topic          String? // money | weightloss | blog | english | habits
  flowId         String?
  flow           Flow?    @relation(fields: [flowId], references: [id])
  telegramChatId BigInt?  @unique
  title          String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  memberships ChatMembership[]

  @@unique([kind, topic, flowId])
}

model ChatMembership {
  chatId     String
  chat       TelegramChat @relation(fields: [chatId], references: [id])
  userId     BigInt
  inviteLink String?
  status     String       @default("invited") // invited | joined | removed | declined
  joinedAt   DateTime?
  removedAt  DateTime?
  updatedAt  DateTime     @updatedAt

  @@id([chatId, userId])
}

model Expert {
  id          String  @id @default(uuid())
  name        String
  direction   String // money | english | habits | blog | weightloss
  bio         String?
  photoUrl    String?
  adminUserId String? @unique
  active      Boolean @default(true)

  meetings Meeting[]
}

model Meeting {
  id           String   @id @default(uuid())
  expertId     String?
  expert       Expert?  @relation(fields: [expertId], references: [id])
  direction    String
  title        String
  description  String?
  startsAt     DateTime
  durationMin  Int      @default(60)
  joinUrl      String?
  status       String   @default("scheduled") // scheduled | done | canceled
  nextStep     String?
  expertReport String?
  stats        Json     @default("{}")
  createdAt    DateTime @default(now())

  attendances Attendance[]

  @@index([startsAt])
}

model Attendance {
  meetingId     String
  meeting       Meeting   @relation(fields: [meetingId], references: [id])
  userId        BigInt
  user          User      @relation(fields: [userId], references: [id])
  joinClickedAt DateTime?
  attended      Boolean?
  remindedAt    DateTime?

  @@id([meetingId, userId])
}

// ───────────── Отзывы, карточки, рефералы ─────────────

model Review {
  id               String    @id @default(uuid())
  userId           BigInt
  user             User      @relation(fields: [userId], references: [id])
  flowId           String?
  trigger          String // day14 | final | meeting
  meetingId        String?
  rating           Int?
  emotions         String[]  @default([])
  changes          String?
  result           String?
  metrics          Json      @default("{}")
  mediaIds         String[]  @default([])
  allowText        Boolean   @default(false)
  allowPhoto       Boolean   @default(false)
  allowName        Boolean   @default(false)
  consentRevokedAt DateTime?
  featured         Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([trigger, createdAt])
}

model ShareCard {
  id           String         @id @default(uuid())
  membershipId String
  membership   FlowMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  week         Int // 1..4, 5 = итог
  stats        Json
  createdAt    DateTime       @default(now())

  @@unique([membershipId, week])
}

model ReferralLink {
  code      String   @id
  userId    BigInt   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  visits ReferralVisit[]
}

model ReferralVisit {
  code      String
  link      ReferralLink @relation(fields: [code], references: [code])
  visitorId BigInt       @unique // засчитывается только первый визит нового пользователя
  createdAt DateTime     @default(now())
}

// ───────────── Аналитика и эксперименты ─────────────

model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  eventId    String   @unique // генерируется клиентом — дедупликация
  userId     BigInt?
  user       User?    @relation(fields: [userId], references: [id])
  sessionId  String
  flowId     String?
  screenId   String?
  eventName  String
  ts         DateTime
  tariffId   String?
  variant    String?
  device     String?
  metadata   Json     @default("{}")
  receivedAt DateTime @default(now())

  @@index([eventName, ts])
  @@index([userId, ts])
  @@index([screenId, ts])
}

model Experiment {
  key       String   @id
  title     String
  variants  Json // [{key, weight}]
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ExperimentAssignment {
  userId        BigInt
  user          User     @relation(fields: [userId], references: [id])
  experimentKey String
  variant       String
  createdAt     DateTime @default(now())

  @@id([userId, experimentKey])
}

// ───────────── Бот ─────────────

model BotMessageTemplate {
  key          String   @id
  title        String
  text         String
  buttons      Json     @default("[]") // [{text, screen}]
  enabled      Boolean  @default(false)
  isMarketing  Boolean  @default(false)
  delayMinutes Int      @default(0)
  capHours     Int      @default(24) // не чаще одного сообщения этого шаблона за N часов
  priority     Int      @default(50)
  approved     Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model BotMessageLog {
  id          String    @id @default(uuid())
  userId      BigInt
  user        User      @relation(fields: [userId], references: [id])
  templateKey String
  dedupeKey   String    @unique
  status      String // sent | failed | skipped
  error       String?
  sentAt      DateTime  @default(now())
  clickedAt   DateTime?
  convertedAt DateTime?

  @@index([userId, sentAt])
  @@index([templateKey, sentAt])
}

// ───────────── Админка, настройки, задачи ─────────────

enum AdminRole {
  owner
  admin
  moderator
  expert
  support
  analyst
}

model AdminUser {
  id           String    @id @default(uuid())
  login        String    @unique
  passwordHash String
  role         AdminRole
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Upsell {
  code        String  @id
  title       String
  price       Int
  description String
  disclaimer  String?
  active      Boolean @default(false)
  sort        Int     @default(0)
}

model UpsellRequest {
  id        String   @id @default(uuid())
  userId    BigInt
  code      String
  status    String   @default("new") // new | contacted | paid | declined
  createdAt DateTime @default(now())
}

model JobRun {
  key    String   @id // идемпотентный ключ однократной задачи
  ranAt  DateTime @default(now())
  result Json?
}

/// Общий чат отчётов потока: отчёты публикуются сюда автоматически, участники переписываются и отвечают на сообщения
model FeedMessage {
  id        String        @id @default(uuid())
  flowId    String
  flow      Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  userId    BigInt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String?
  reportId  String?       @unique
  replyToId String?
  replyTo   FeedMessage?  @relation("FeedReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   FeedMessage[] @relation("FeedReply")
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([flowId, createdAt])
}
