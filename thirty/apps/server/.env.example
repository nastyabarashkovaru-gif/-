# Postgres
DATABASE_URL=postgresql://thirty:thirty@localhost:5432/thirty
# Публичный HTTPS-адрес сервиса (Railway domain), без / в конце
PUBLIC_URL=
# BotFather
BOT_TOKEN=
BOT_USERNAME=
APP_SHORT_NAME=app
# Админка
ADMIN_JWT_SECRET=
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=
# Платежи: mock (sandbox без денег) или prodamus
PAYMENT_PROVIDER=mock
PRODAMUS_FORM_URL=https://<магазин>.payform.ru
PRODAMUS_SECRET_KEY=
PRODAMUS_SYS=
PRODAMUS_DEMO=false
# Медиа (S3-совместимое хранилище); пусто — локальная папка UPLOAD_DIR
S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_SIGNING_SECRET=
# Планировщик фоновых задач (включать на одном инстансе)
SCHEDULER=true
# Только локально
DEV_AUTH=false
