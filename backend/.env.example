# Токен бота из @BotFather (нужен для проверки подписи Telegram initData)
BOT_TOKEN=123456789:AAExampleTelegramBotToken

# Порт, на котором слушает backend
PORT=4000

# Секрет для подписи админских JWT-токенов (сгенерируйте случайную строку)
ADMIN_JWT_SECRET=change-me-to-a-random-secret

# Логин и пароль для входа в админ-панель (Настя)
ADMIN_LOGIN=nastya
ADMIN_PASSWORD=change-me

# Длительность челленджа в днях
CHALLENGE_DAYS=100

# Настройки Продамуса (см. ЛК Продамуса -> Магазин -> Настройки -> API)
PRODAMUS_SHOP_URL=https://your-shop.payform.ru
PRODAMUS_SECRET_KEY=change-me-prodamus-secret

# Разрешить вход без Telegram initData (только для локальной разработки!)
DEV_MODE=true
